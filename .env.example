# Zapis runs without any third-party API keys — quantification is local
# and rule-based. These are the only knobs.

PORT=8787
DB_PATH=./data/zapis.db

# Required before anyone can create an account. Unset means registration
# is refused outright, so a deployment you forgot to configure is closed
# rather than open. Share it only with the people you want on your board.
ZAPIS_INVITE_CODE=

# Set to "production" when deploying: it turns on secure cookies, trusts
# the proxy's forwarded headers, and serves the built frontend from dist/.
# NODE_ENV=production
